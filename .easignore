# EAS Build upload ignore list.
# NOTE: when this file exists, EAS uses it INSTEAD of .gitignore, so it must
# repeat everything .gitignore excludes as well as the EAS-only entries.

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# typescript
*.tsbuildinfo

app-example

# generated native folders
/ios
/android

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
logs
*.log

# OS
Thumbs.db

# Build files
*.tgz
*.tar.gz
.cache/

# Webdev artifacts (checkpoint zips, migrations, etc.)
.webdev/
.project-config.json

# Android signing credentials (uploaded separately, not via the tarball)
credentials.json
credentials/

# EAS-only: local device tooling committed to the repo. Contains a 90MB Expo Go
# APK plus adb/platform-tools that the build servers never use. Excluding this
# cuts the upload tarball from ~146MB to ~33MB.
.tools/
