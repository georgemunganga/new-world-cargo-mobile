{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "development",
        "EXPO_PUBLIC_API_MODE": "mock",
        "EXPO_PUBLIC_MAPS_PROVIDER": "mock",
        "EXPO_PUBLIC_PAYMENTS_PROVIDER": "mock"
      }
    },
    "staging": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "staging",
        "EXPO_PUBLIC_API_MODE": "laravel",
        "EXPO_PUBLIC_API_BASE_URL": "https://api.newworldcargo.com",
        "EXPO_PUBLIC_PUBLIC_TRACKING_BASE_URL": "https://api.newworldcargo.com",
        "EXPO_PUBLIC_MAPS_PROVIDER": "native",
        "EXPO_PUBLIC_PAYMENTS_PROVIDER": "laravel"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_API_MODE": "laravel",
        "EXPO_PUBLIC_API_BASE_URL": "https://api.newworldcargo.com",
        "EXPO_PUBLIC_PUBLIC_TRACKING_BASE_URL": "https://api.newworldcargo.com",
        "EXPO_PUBLIC_MAPS_PROVIDER": "native",
        "EXPO_PUBLIC_PAYMENTS_PROVIDER": "laravel"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
