{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "credentialsSource": "local",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "development",
        "EXPO_PUBLIC_EXPO_PROJECT_ID": "702dd433-05f9-4c44-b178-eaccf2e43403",
        "EXPO_PUBLIC_API_MODE": "laravel",
        "EXPO_PUBLIC_MAPS_PROVIDER": "native",
        "EXPO_PUBLIC_PAYMENTS_PROVIDER": "laravel",
        "EXPO_PUBLIC_API_BASE_URL": "https://api.newworldcargo.com/api/v1/",
        "EXPO_PUBLIC_ADMIN_API_BASE_URL": "https://admin.newworldcargo.com/api/v1/",
        "EXPO_PUBLIC_PUBLIC_TRACKING_BASE_URL": "https://api.newworldcargo.com/api/v1/"
      }
    },
    "staging": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "staging",
        "EXPO_PUBLIC_EXPO_PROJECT_ID": "702dd433-05f9-4c44-b178-eaccf2e43403",
        "EXPO_PUBLIC_API_MODE": "laravel",
        "EXPO_PUBLIC_API_BASE_URL": "https://api.newworldcargo.com/api/v1/",
        "EXPO_PUBLIC_PUBLIC_TRACKING_BASE_URL": "https://api.newworldcargo.com/api/v1/",
        "EXPO_PUBLIC_MAPS_PROVIDER": "native",
        "EXPO_PUBLIC_PAYMENTS_PROVIDER": "laravel",
        "EXPO_PUBLIC_ADMIN_API_BASE_URL": "https://admin.newworldcargo.com/api/v1/"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_EXPO_PROJECT_ID": "702dd433-05f9-4c44-b178-eaccf2e43403",
        "EXPO_PUBLIC_API_MODE": "laravel",
        "EXPO_PUBLIC_API_BASE_URL": "https://api.newworldcargo.com/api/v1/",
        "EXPO_PUBLIC_PUBLIC_TRACKING_BASE_URL": "https://api.newworldcargo.com/api/v1/",
        "EXPO_PUBLIC_MAPS_PROVIDER": "native",
        "EXPO_PUBLIC_PAYMENTS_PROVIDER": "laravel",
        "EXPO_PUBLIC_ADMIN_API_BASE_URL": "https://admin.newworldcargo.com/api/v1/"
      }
    }
  },
  "submit": {
    "production": {}
  }
